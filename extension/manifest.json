{
  "manifest_version": 3,
  "name": "ScamRadar+",
  "version": "0.1.0",
  "description": "Privacy-first scam detection. Highlight any text on any page, right-click, and let ScamRadar+ analyse it.",
  "minimum_chrome_version": "116",

  "permissions": [
    "contextMenus",
    "scripting",
    "activeTab",
    "storage"
  ],

  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_title": "ScamRadar+",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
